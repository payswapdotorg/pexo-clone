# Copy to .env and fill in what you need. Everything except DATABASE_URL is
# optional — the app falls back to the sandbox z-ai SDK + local disk storage.

# REQUIRED: Postgres connection string (Neon, Supabase, RDS, local...).
# Direct endpoint for migrations (bun run db:push).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session cookie HMAC secret (any long random string).
VIDRA_DEMO_SECRET="change-me"

# --- AI providers (first configured + working wins) ---------------------
# OpenRouter (optional): https://openrouter.ai
# OPENROUTER_API_KEY="sk-or-v1-..."
# LLM_MODEL="google/gemini-2.5-flash"

# Alibaba Model Studio / DashScope (LLM + image + video) — international
# endpoint by default. Models: qwen-plus (LLM), wan2.2-t2i-flash (image),
# wan2.1-t2v-turbo (video).
# DASHSCOPE_API_KEY="sk-..."
# DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com"
# DASHSCOPE_LLM_MODEL="qwen-plus"
# DASHSCOPE_IMAGE_MODEL="wan2.2-t2i-flash"
# DASHSCOPE_VIDEO_MODEL="wan2.1-t2v-turbo"

# --- Artifact storage (default: local data/artifacts/) --------------------
# Cloudflare R2 (S3-compatible). All four must be set to activate R2 mode.
# R2_BUCKET="pexo-artifacts"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
